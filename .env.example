# Optional browser API origin. Leave empty for local Vite proxy / same-origin API.
VITE_API_BASE_URL=

# Project Pages path; use / for a custom domain.
VITE_BASE_PATH=/english-vocabulary-desk/

# Used when building an Android APK that loads the hosted Funnel app.
# The /eng-vocabulary/ suffix is required because the Funnel serves this app
# and its same-origin API below that path.
